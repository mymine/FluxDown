# GitHub 私有仓库配置
# 在服务器的 .env 文件中设置这些值（不要提交 .env 到 Git）
# ⚠️ 本文件是模板，只放占位符——任何真实密钥都严禁写入本文件

# 仓库地址（格式: owner/repo）
GITHUB_REPO=zerx-lab/FluxDown

# GitHub Personal Access Token (classic)
# 需要 repo 权限（读取私有仓库 Release）
# 创建地址: https://github.com/settings/tokens
GITHUB_TOKEN=

# GitHub Webhook 签名密钥（与 GitHub Webhook 设置中的 Secret 一致）
GITHUB_WEBHOOK_SECRET=
# 可选：GitHub Projects 专用 Token（需要 read:project scope）
GITHUB_PROJECT_TOKEN=
# GitHub Projects 看板编号（URL 末尾的数字，如 /projects/4 则填 4）
GITHUB_PROJECT_NUMBER=4
# Projects 所属账号（用户名或组织名，如 zerx-lab）
GITHUB_PROJECT_OWNER=zerx-lab
# GitHub OAuth 登录（定价页投票/讨论需真实 GitHub 用户）
# OAuth App 在 https://github.com/settings/developers 创建，
# 回调 URL 填 https://<本站域名>/api/auth/github/callback（本地开发另建一个 App 指向 http://127.0.0.1:4321）
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# SMTP 邮件配置（用于 Webhook 触发的反馈回复通知）
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 自由付款支付网关
# Base URL（含 /api 前缀），本地测试如 http://localhost:5173/api，生产如 https://ops.fluxdown.com/api
PAY_GATEWAY_URL=http://localhost:5173/api
# 应用 ID（CreateApp 时分配）
PAY_APP_ID=
# 应用密钥（仅服务端使用，绝不暴露给前端；CreateApp 时一次性返回）
PAY_APP_SECRET=
# 异步回调：在支付平台后台为该 app 配置 notify_url。notify_url 必须带 SITE_BASE 前缀，
# 例如部署在 /v2 下时为 https://<本站域名>/v2/api/pay/notify（根部署则为 /api/pay/notify）。
# 注意：网关对一个 app 只有一个 notify_url；v1 与 v2 共用同一个支付应用时只有其中一个站点
# 能收到回调，建议 v2 使用独立的支付应用，或关闭 v2 的支付入口。
# （服务端验签后标记订单已支付，前端轮询 /api/pay/status 显示感谢页；无需额外 env）
# FluxCloud 云端服务根地址（无 /api 前缀），定价页经 /api/cloud/plans 中转拉取公开套餐目录
FLUXCLOUD_API_BASE=http://127.0.0.1:8720
# 阿里云 OSS 发布资产（/api/download 只用它做 HEAD 存在性探测，下载经 dl-cn 镜像）
# RAM 子账号只需目标 bucket 的只读权限；留空则大陆访客也走 GitHub
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 以下三项有内置默认值（zerx-lab / oss-cn-beijing.aliyuncs.com / FluxDownRelease），一般无需改
#OSS_BUCKET=
#OSS_ENDPOINT=
#OSS_RELEASE_PREFIX=
# 中国大陆访客（阿里云 ESA 托管转换的 Ali-Ip-Country=cn，反代写入 X-Client-Country）与 source=oss 的下载镜像：
# 基址默认 https://dl-cn.fluxdown.com（ESA 边缘函数 cdn/esa-dl-cn.js，私有 OSS 回源），
# CN_CDN_AUTH_KEY = 阿里云「URL 鉴权 → A 方式」格式的主 KEY，必须与边缘函数变量 CN_CDN_AUTH_KEY 同值
# （有效时长 10800 秒），留空则全部访客走 GitHub
#CN_CDN_BASE=
#CN_CDN_AUTH_KEY=
# 官网浏览器下载验证码通行证（src/lib/download-pass.ts）的 HMAC 密钥（如 openssl rand -hex 32）：配置后浏览器须先过
# ESA AI 验证码（规则 download-pass）才拿上面的 dl-cn 镜像，否则 GitHub；应用内更新不受影响。留空则不要求验证码。
# 必须先让反代给官网写 X-Fluxdown-Edge（经 ESA 鉴别通过为 1），否则浏览器全部回落 GitHub
#DOWNLOAD_PASS_SECRET=
# 123 云盘下载源（src/lib/pan123.ts）：仅 ≥ 0.6.0 的应用内更新（UA fluxdown-agent|android/<版本>、资产在当前更新清单、
# 单 IP 每日 10 条，须通过下载准入，不分地区）优先 302 到 123 直链（URL 鉴权签名，10 分钟有效），
# 否则再走上面的 dl-cn 镜像（仅大陆）与 GitHub；官网浏览器下载不走 123。
# WebDAV 账号与应用密码：123「工具中心 → 第三方挂载」里只授权发布目录的应用（与 CI secrets PAN123_WEBDAV_* 同值），
# 只用于 PROPFIND 确认资产；UID 与鉴权密钥：123「流量包 → 直链流量包 → URL 鉴权」。任一项留空则关闭
#PAN123_WEBDAV_URL=https://webdav.123pan.cn/webdav
#PAN123_WEBDAV_USER=
#PAN123_WEBDAV_PASSWORD=
#PAN123_UID=
#PAN123_AUTH_KEY=
# 直链域名（默认 https://<UID>.cdn.123clouddisk.cn）与直链空间文件夹（默认 fd-release）
#PAN123_DIRECT_BASE=
#PAN123_DIRECT_FOLDER=
