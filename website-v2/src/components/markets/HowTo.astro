---
/** 市场页底部「如何使用」:三步编号格 + 末格贡献入口(指南 / 仓库 / SDK;静态渲染,不依赖索引加载)。 */
import { ArrowRight, ArrowUpRight } from "lucide-react";
import { BrandIcon, type BrandName } from "@/components/icons/brand";

interface HowToLink {
  href: string;
  label: string;
  /** 外链:新标签页打开 */
  external?: boolean;
  brand?: BrandName;
}

interface Props {
  eyebrow: string;
  title: string;
  steps: readonly string[];
  links: readonly HowToLink[];
}
const { eyebrow, title, steps, links } = Astro.props;
---

<section class="frame">
  <div class="rule"></div>
  <div class="section-tight">
    <span class="eyebrow">{eyebrow}</span>
    <h2 class="h3 mt-3" data-reveal>{title}</h2>
  </div>
  <ol class="cells grid-cols-1 border-t border-line md:grid-cols-3">
    {
      steps.map((step, i) => (
        <li class="cell flex flex-col gap-4" data-reveal style={`--d:${i}`}>
          <span class="num font-mono text-[11px] tracking-[0.14em] text-subtle">
            {String(i + 1).padStart(2, "0")} / {String(steps.length).padStart(2, "0")}
          </span>
          <p class="text-[14.5px] leading-relaxed text-muted">{step}</p>
          {i === steps.length - 1 && (
            <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
              {links.map((link) =>
                link.external ? (
                  <a href={link.href} target="_blank" rel="noopener noreferrer" class="link inline-flex items-center gap-1.5">
                    {link.brand && <BrandIcon name={link.brand} size={13} />}
                    {link.label}
                    <ArrowUpRight size={14} aria-hidden="true" />
                  </a>
                ) : (
                  <a href={link.href} class="link inline-flex items-center gap-1">
                    {link.label}
                    <ArrowRight size={14} aria-hidden="true" />
                  </a>
                ),
              )}
            </div>
          )}
        </li>
      ))
    }
  </ol>
</section>
