---
/** 无头服务器:Docker 命令 + 独立二进制 + OpenWrt / QNAP / 群晖 / 飞牛套件。 */
import { HardDrive, Router, Server, ArrowRight } from "lucide-react";
import AssetGroup, { type RowSpec } from "./AssetGroup.astro";
import CodeBlock from "./CodeBlock.astro";
import { BrandIcon } from "@/components/icons/brand";
import { download } from "@/i18n/messages/download";
import type { Lang } from "@/i18n/config";
import { GITHUB_URL } from "@/lib/site-nav";
import { withBase } from "@/lib/base";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = download[lang];
const fallback = `${GITHUB_URL}/releases`;
const title = t.server.title.replace(/<em>(.*?)<\/em>/g, '<span class="serif">$1</span>');
const setupGuide = withBase(`/docs/${lang}/headless-server/setup/`);
const dockerGuide = withBase(`/docs/${lang}/headless-server/docker/`);

const IMAGE = "ghcr.io/zerx-lab/fluxdown-server:latest";
const RUN = `docker run -d --name fluxdown-server \\
  -p 17800:17800 \\
  -v fluxdown-data:/data \\
  -v ./downloads:/root/Downloads \\
  --restart unless-stopped \\
  ${IMAGE}`;
const COMPOSE = `services:
  fluxdown-server:
    image: ${IMAGE}
    container_name: fluxdown-server
    restart: unless-stopped
    ports:
      - "17800:17800"
    volumes:
      - fluxdown-data:/data
      - ./downloads:/root/Downloads

volumes:
  fluxdown-data:

# docker compose up -d`;

const s = "server.assets";
const binaries: RowSpec[] = [
  { path: `${s}.windows_x64`, label: t.os.windows, detail: "x64", ext: ".zip" },
  { path: `${s}.windows_arm64`, label: t.os.windows, detail: "ARM64", ext: ".zip" },
  { path: `${s}.linux_x64`, label: t.os.linux, detail: "x64", ext: ".tar.gz" },
  { path: `${s}.linux_arm64`, label: t.os.linux, detail: "ARM64", ext: ".tar.gz" },
  { path: `${s}.macos_arm64`, label: t.os.macos, detail: t.arch.appleSilicon, ext: ".tar.gz" },
  { path: `${s}.macos_x64`, label: t.os.macos, detail: t.arch.intel, ext: ".tar.gz" },
];
const openwrt: RowSpec[] = [
  { path: `${s}.openwrt_apk_x64`, label: "x86_64", detail: t.server.openwrtApk, ext: ".apk" },
  { path: `${s}.openwrt_apk_arm64`, label: "aarch64", detail: t.server.openwrtApk, ext: ".apk" },
  { path: `${s}.openwrt_apk_luci`, label: t.server.luci, detail: t.server.openwrtApk, ext: ".apk" },
  { path: `${s}.openwrt_x64`, label: "x86_64", detail: t.server.openwrtIpk, ext: ".ipk" },
  { path: `${s}.openwrt_arm64`, label: "aarch64", detail: t.server.openwrtIpk, ext: ".ipk" },
  { path: `${s}.openwrt_luci`, label: t.server.luci, detail: t.server.openwrtIpk, ext: ".ipk" },
];
const qnap: RowSpec[] = [
  { path: `${s}.qnap_x64`, label: "x64", ext: ".qpkg" },
  { path: `${s}.qnap_arm64`, label: "ARM64", ext: ".qpkg" },
];
const synology: RowSpec[] = [
  { path: `${s}.synology_dsm7_x64`, label: "DSM 7", detail: "x64", ext: ".spk" },
  { path: `${s}.synology_dsm7_arm64`, label: "DSM 7", detail: "ARM64", ext: ".spk" },
  { path: `${s}.synology_dsm6_x64`, label: "DSM 6", detail: "x64", ext: ".spk" },
  { path: `${s}.synology_dsm6_arm64`, label: "DSM 6", detail: "ARM64", ext: ".spk" },
];
const fnos: RowSpec[] = [
  { path: `${s}.fnos_x64`, label: "x64", ext: ".fpk" },
  { path: `${s}.fnos_arm64`, label: "ARM64", ext: ".fpk" },
];
---

<section class="frame" id="server" aria-labelledby="server-title">
  <div class="section-tight flex flex-col gap-4">
    <span class="eyebrow">{t.server.eyebrow}</span>
    <h2 id="server-title" class="h2 max-w-[18ch]" data-reveal set:html={title} />
    <p class="lede max-w-[62ch]" data-reveal style="--d:1">{t.server.lede}</p>
  </div>

  <div class="docker border-t border-line" id="docker">
    <div class="flex flex-col gap-3">
      <div class="flex items-center gap-3">
        <span class="badge" aria-hidden="true"><BrandIcon name="docker" size={17} /></span>
        <div>
          <h3 class="text-[17px] font-[560] tracking-[-0.015em]">{t.server.dockerTitle}</h3>
          <p class="text-[13px] text-muted">{t.server.dockerDesc}</p>
        </div>
      </div>
      <p class="max-w-[44ch] text-[13.5px] leading-relaxed text-muted">{t.server.dockerHint}</p>
      <a class="link inline-flex items-center gap-1 self-start text-[13px]" href={dockerGuide}>
        {t.server.dockerGuide}<ArrowRight size={13} strokeWidth={2} aria-hidden="true" />
      </a>
    </div>
    <div class="grid min-w-0 gap-4">
      <CodeBlock lang={lang} id="docker-run" caption="docker run" code={RUN} />
      <CodeBlock lang={lang} id="docker-compose" caption="docker-compose.yml" code={COMPOSE} />
    </div>
  </div>

  <div class="cells grid-2 border-t border-line">
    <AssetGroup lang={lang} id="server-binaries" title={t.server.binariesTitle} desc={t.server.binariesDesc} versionPath="server.version" fallback={fallback} rows={binaries}>
      <Fragment slot="icon"><Server size={16} strokeWidth={1.75} /></Fragment>
      <a class="link mt-auto self-start text-[13px]" href={setupGuide}>{t.server.guide}</a>
    </AssetGroup>
    <AssetGroup lang={lang} id="openwrt" title="OpenWrt" desc={t.server.openwrtDesc} versionPath="server.version" fallback={fallback} rows={openwrt}>
      <Fragment slot="icon"><Router size={16} strokeWidth={1.75} /></Fragment>
      <a class="link mt-auto self-start text-[13px]" href={setupGuide}>{t.server.guide}</a>
    </AssetGroup>
    <AssetGroup lang={lang} id="qnap" title="QNAP" desc={t.server.qnapDesc} versionPath="server.version" fallback={fallback} rows={qnap}>
      <Fragment slot="icon"><HardDrive size={16} strokeWidth={1.75} /></Fragment>
      <a class="link mt-auto self-start text-[13px]" href={setupGuide}>{t.server.guide}</a>
    </AssetGroup>
    <AssetGroup lang={lang} id="synology" title="Synology" desc={t.server.synologyDesc} versionPath="server.version" fallback={fallback} rows={synology}>
      <Fragment slot="icon"><HardDrive size={16} strokeWidth={1.75} /></Fragment>
      <a class="link mt-auto self-start text-[13px]" href={dockerGuide}>{t.server.dockerGuide}</a>
    </AssetGroup>
    <AssetGroup lang={lang} id="fnos" title={t.server.fnosTitle} desc={t.server.fnosDesc} versionPath="server.version" fallback={fallback} rows={fnos}>
      <Fragment slot="icon"><HardDrive size={16} strokeWidth={1.75} /></Fragment>
      <a class="link mt-auto self-start text-[13px]" href={dockerGuide}>{t.server.dockerGuide}</a>
    </AssetGroup>
  </div>
  <div class="rule"></div>
</section>

<style>
  .docker {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    padding: clamp(24px, 3vw, 40px) clamp(20px, 4vw, 56px);
  }
  @media (min-width: 900px) {
    .docker {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }
  .badge {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--bg-elev);
    box-shadow: 0 0 0 1px var(--line-strong) inset;
  }
  .grid-2 {
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 760px) {
    .grid-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* 分组数为奇数时末项横跨整行,避免右下角露出网格底色 */
    .grid-2 > :global(:last-child:nth-child(odd)) {
      grid-column: 1 / -1;
    }
  }
</style>
