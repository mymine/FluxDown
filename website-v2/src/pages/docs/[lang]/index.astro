---
/**
 * 文档首页(静态预渲染,en/zh 各一条路由):hero + 内联搜索(支持 `?q=`)+ 分区卡片 + 与 Ghost Downloader 对比
 * + 参与贡献(各仓库入口)。
 */
import { getCollection } from "astro:content";
import { ArrowRight, ArrowUpRight } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import DocsSearch from "@/components/docs/DocsSearch";
import DocsCompareGd from "@/components/docs/DocsCompareGd.astro";
import { BrandIcon } from "@/components/icons/brand";
import { SECTION_ICONS, docsAlternates, docsRepoTree } from "@/components/docs/meta";
import { buildDocsNav, type DocsLang } from "@/lib/docs-nav";
import { docs } from "@/i18n/messages/docs";
import { contribute } from "@/i18n/messages/contribute";
import { docsCompare } from "@/i18n/messages/docsCompare";
import {
  CONTRIBUTE_AREAS,
  CONTRIBUTE_OVERVIEW,
  PLUGIN_SDK_NPM_URL,
  PLUGIN_SDK_PACKAGE,
  contributeGuidePath,
  githubUrl,
} from "@/lib/ecosystem";
import { withBase } from "@/lib/base";

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "zh" } }];
}

const lang = Astro.params.lang as DocsLang;
const t = docs[lang];
const all = await getCollection("docs");
const { groups } = buildDocsNav(all, lang);
// contributing 由底部「参与贡献」区承载,卡片区保持 3 × 2 平衡
const cards = groups.filter((g) => g.id !== "contributing");
const firstPage = groups[0]?.items[0]?.href ?? `/docs/${lang}/`;
const serif = (html: string) => html.replace(/<em>(.*?)<\/em>/g, '<span class="serif">$1</span>');
const titleHtml = serif(t.index.title);
const c = contribute[lang];
const cmp = docsCompare[lang];
---

<Layout
  lang={lang}
  title={t.metaTitle}
  description={t.metaDescription}
  alternates={docsAlternates("", ["en", "zh"])}
>
  <section class="frame">
    <div class="section docs-hero">
      <div class="docs-hero-copy">
        <span class="eyebrow" data-scramble>{t.index.eyebrow}</span>
        <h1 class="h2" data-reveal set:html={titleHtml} />
        <p class="lede max-w-[58ch]" data-reveal style="--d:1">{t.index.lede}</p>
        <div class="flex flex-wrap gap-3" data-reveal style="--d:2">
          <a href={withBase(firstPage)} class="btn btn-primary">
            {t.index.start}
            <ArrowRight size={15} aria-hidden="true" />
          </a>
          <a href={docsRepoTree()} target="_blank" rel="noopener noreferrer" class="btn btn-ticks">
            <BrandIcon name="github" size={15} />
            {t.index.contribute}
          </a>
        </div>
      </div>
      <div class="docs-hero-search" data-reveal style="--d:3">
        <DocsSearch client:load lang={lang} variant="hero" />
      </div>
    </div>
    <div class="rule"></div>
  </section>

  <section class="frame" aria-labelledby="docs-sections-label">
    <h2 id="docs-sections-label" class="sr-only">{t.index.sectionsLabel}</h2>
    <div class="cells docs-cards">
      {
        cards.map((group, i) => {
          const Icon = SECTION_ICONS[group.id];
          return (
            <article id={group.id} class="cell spot docs-card" data-reveal style={`--d:${i}`}>
              <div class="docs-card-top">
                <span class="docs-card-icon">
                  <Icon size={16} strokeWidth={1.6} aria-hidden="true" />
                </span>
                <span class="eyebrow-plain num">{String(i + 1).padStart(2, "0")}</span>
              </div>
              <h3 class="h3 docs-card-title">{group.label}</h3>
              <p class="docs-card-desc">{t.sections[group.id]}</p>
              <ul class="docs-card-links">
                {group.items.map((item) => (
                  <li>
                    <a href={withBase(item.href)}>
                      <span>{item.title}</span>
                      {item.fallback && (
                        <span class="docs-card-tag" title={t.nav.untranslatedTitle}>
                          {t.nav.untranslated}
                        </span>
                      )}
                      <ArrowRight size={13} className="docs-card-arrow" aria-hidden="true" />
                    </a>
                  </li>
                ))}
              </ul>
              <p class="eyebrow-plain num docs-card-count">{t.index.pages(group.items.length)}</p>
            </article>
          );
        })
      }
    </div>
    <div class="rule"></div>
  </section>

  <section class="frame" id="compare" aria-labelledby="docs-compare-title">
    <div class="section-tight">
      <div class="max-w-[62ch]">
        <span class="eyebrow">{cmp.eyebrow}</span>
        <h2 id="docs-compare-title" class="h3 mt-3" data-reveal set:html={serif(cmp.title)} />
        <p class="mt-3 text-[15px] leading-relaxed text-muted" data-reveal style="--d:1">{cmp.lede}</p>
      </div>
      <div class="mt-8" data-reveal style="--d:2">
        <DocsCompareGd lang={lang} />
      </div>
    </div>
    <div class="rule"></div>
  </section>

  <section class="frame" id="contributing" aria-labelledby="docs-contrib-title">
    <div class="section-tight docs-contrib-head">
      <div class="max-w-[62ch]">
        <span class="eyebrow">{c.eyebrow}</span>
        <h2 id="docs-contrib-title" class="h3 mt-3" data-reveal set:html={serif(c.title)} />
        <p class="mt-3 text-[15px] leading-relaxed text-muted" data-reveal style="--d:1">{c.lede}</p>
      </div>
      <a href={withBase(contributeGuidePath(lang, CONTRIBUTE_OVERVIEW))} class="btn btn-secondary shrink-0">
        {c.overview}
        <ArrowRight size={14} aria-hidden="true" />
      </a>
    </div>
    <div class="cells docs-contrib border-t border-line">
      {
        CONTRIBUTE_AREAS.map((area, i) => {
          const copy = c.areas[area.id];
          return (
            <article class="cell spot docs-contrib-card" data-reveal style={`--d:${i}`}>
              <div class="docs-card-top">
                <span class="docs-card-icon">
                  <area.icon size={16} strokeWidth={1.6} aria-hidden="true" />
                </span>
                <span class="eyebrow-plain num">{String(i + 1).padStart(2, "0")}</span>
              </div>
              <h3 class="docs-contrib-title">{copy.title}</h3>
              <p class="docs-card-desc">{copy.desc}</p>
              <div class="docs-contrib-links">
                <a href={withBase(contributeGuidePath(lang, area.guide))} class="docs-contrib-guide">
                  {c.guide}
                  <ArrowRight size={14} aria-hidden="true" />
                </a>
                <a
                  href={githubUrl(area.repo)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="docs-contrib-repo"
                  aria-label={`${c.repo}: ${area.repo}`}
                >
                  <BrandIcon name="github" size={13} />
                  <span>{area.repo}</span>
                  <ArrowUpRight size={12} aria-hidden="true" />
                </a>
                {area.id === "plugins" && (
                  <a
                    href={PLUGIN_SDK_NPM_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="docs-contrib-repo"
                    aria-label={`${c.sdk}: ${c.sdkDesc}`}
                  >
                    <BrandIcon name="npm" size={13} />
                    <span>{PLUGIN_SDK_PACKAGE}</span>
                    <ArrowUpRight size={12} aria-hidden="true" />
                  </a>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </section>
</Layout>

<style>
  #compare {
    scroll-margin-top: var(--header-h);
  }
  .docs-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }
  .docs-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .docs-hero-search {
    max-width: 680px;
  }

  .docs-cards {
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 720px) {
    .docs-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .docs-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .docs-card {
    display: flex;
    flex-direction: column;
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .docs-card:target {
    background: var(--bg-sunken);
  }
  .docs-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .docs-card-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--bg-elev);
    color: var(--accent-ink);
  }
  .docs-card-title {
    margin-top: 22px;
  }
  .docs-card-desc {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-muted);
  }
  .docs-card-links {
    margin-top: 18px;
    border-top: 1px solid var(--line);
  }
  .docs-card-links a {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 0;
    border-bottom: 1px dashed var(--line);
    font-size: 14px;
    color: var(--fg);
    transition: color 160ms var(--ease-out);
  }
  .docs-card-links a > span:first-child {
    flex: 1;
  }
  .docs-card-links a:hover {
    color: var(--accent-ink);
  }
  .docs-card-links :global(.docs-card-arrow) {
    color: var(--fg-subtle);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .docs-card-links a:hover :global(.docs-card-arrow),
  .docs-card-links a:focus-visible :global(.docs-card-arrow) {
    opacity: 1;
    transform: none;
    color: var(--accent-ink);
  }
  .docs-card-tag {
    padding: 0 5px;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.06em;
    color: var(--fg-subtle);
  }
  .docs-card-count {
    margin-top: auto;
    padding-top: 20px;
  }

  .docs-contrib-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  @media (min-width: 900px) {
    .docs-contrib-head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  /* 5 张卡:窄屏单列;中屏两列、末张通栏;宽屏 6 栅格——插件 / 主题各占半行,其余三张各占三分之一 */
  .docs-contrib {
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 720px) {
    .docs-contrib {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .docs-contrib-card:last-child {
      grid-column: span 2;
    }
  }
  @media (min-width: 1100px) {
    .docs-contrib {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .docs-contrib-card {
      grid-column: span 2;
    }
    .docs-contrib-card:nth-child(-n + 2) {
      grid-column: span 3;
    }
  }
  .docs-contrib-card {
    display: flex;
    flex-direction: column;
  }
  .docs-contrib-title {
    margin-top: 20px;
    font-size: 17px;
    font-weight: 560;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .docs-contrib-links {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    margin-top: auto;
    padding-top: 22px;
  }
  .docs-contrib-guide {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 500;
    color: var(--accent-ink);
  }
  .docs-contrib-guide :global(svg) {
    transition: transform 160ms var(--ease-out);
  }
  .docs-contrib-guide:hover :global(svg) {
    transform: translateX(3px);
  }
  .docs-contrib-repo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: 100%;
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--fg-muted);
    transition:
      color 160ms var(--ease-out),
      border-color 160ms var(--ease-out);
  }
  .docs-contrib-repo > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .docs-contrib-repo :global(svg) {
    flex: none;
  }
  .docs-contrib-repo:hover {
    color: var(--fg);
    border-color: var(--line-strong);
  }
</style>
