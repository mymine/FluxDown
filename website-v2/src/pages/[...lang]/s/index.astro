---
/**
 * /s/（en）与 /zh/s/（zh）— FluxMesh说明页（noindex，不进 sitemap）。
 *
 * 取件码不能在公开 API 上换成 slug（FluxCloud 没有这样的公开端点），所以这里只解释用法：
 * 取件码在 FluxDown 客户端「FluxMesh → 接收」里输入；网页入口是粘贴分享链接 / 链接 ID 跳到 /s/<slug>。
 */
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import { href, langStaticPaths, resolveLang } from "@/i18n/routing";
import { share } from "@/i18n/messages/share";

export const getStaticPaths = langStaticPaths;
const lang = resolveLang(Astro.params.lang);
const t = share[lang].index;
---

<Layout lang={lang} title={t.meta.title} description={t.meta.description} noindex nofollow>
  <PageHeader eyebrow={share[lang].eyebrow} title={t.title} lede={t.lede}>
    <a class="btn btn-primary" href={href("/download", lang)}>{t.getApp}</a>
  </PageHeader>

  <section class="frame">
    <div class="section flex flex-col gap-6">
      <h2 class="h3">{t.stepsHeading}</h2>
      <ol class="cells md:grid-cols-3">
        {
          t.steps.map((step, i) => (
            <li class="cell flex flex-col gap-2">
              <span class="eyebrow-plain">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="font-medium text-fg">{step.title}</h3>
              <p class="text-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="rule"></div>
    <div class="section flex flex-col gap-4">
      <h2 class="h3">{t.linkHeading}</h2>
      <form
        class="flex max-w-[560px] flex-col gap-3"
        data-share-form
        data-target={href("/s/", lang)}
        novalidate
      >
        <label class="eyebrow-plain" for="share-link">{t.linkLabel}</label>
        <div class="flex flex-wrap gap-3">
          <input
            id="share-link"
            class="field min-w-0 flex-1"
            type="text"
            inputmode="url"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            maxlength="200"
            placeholder={t.linkPlaceholder}
            required
          />
          <button class="btn btn-secondary" type="submit">{t.linkSubmit}</button>
        </div>
        <p
          class="min-h-5 text-sm text-danger"
          role="alert"
          data-share-error
          data-invalid={t.linkInvalid}
          data-code={t.linkIsCode}
        >
        </p>
      </form>
    </div>
  </section>
</Layout>

<script>
  import { parseShareInput } from "@/lib/share-landing";

  const form = document.querySelector<HTMLFormElement>("[data-share-form]");
  const input = form?.querySelector<HTMLInputElement>("input");
  const error = form?.querySelector<HTMLElement>("[data-share-error]");
  if (form && input && error) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const parsed = parseShareInput(input.value);
      if (parsed.kind === "slug") {
        error.textContent = "";
        location.assign(`${form.dataset.target ?? "/s/"}${parsed.slug}`);
        return;
      }
      error.textContent = (parsed.kind === "code" ? error.dataset.code : error.dataset.invalid) ?? "";
    });
  }
</script>
