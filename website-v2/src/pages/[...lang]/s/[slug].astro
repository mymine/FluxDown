---
/**
 * /s/<slug>（en）与 /zh/s/<slug>（zh）— FluxMesh分享落地页，服务端渲染（每个请求现取清单）。
 *
 * 状态机（src/lib/share-landing.ts::landingState）：
 * - ready     云端副本就绪：逐文件「下载」（浏览器经同源代理拿签名 CDN 链接，Turnstile 见 ShareDownload）+ 应用深链
 * - notReady  分享方设备在线时才可下载：只给应用深链
 * - ended     不存在 / 已结束 / 已过期 / 下架：404（不存在）或 410（已结束），不给深链
 * - rateLimited / unavailable  上游限频 / 不可达：429 / 503，仍给应用深链
 *
 * 清单经 src/lib/share-proxy.ts 直连 FluxCloud（与 /api/cloud/share/public/<slug> 同一实现，不绕自身 HTTP）。
 * 全部状态 noindex + no-store，响应头带 X-Robots-Tag。
 */
import { ArrowUpRight, Download } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import PickupCode from "@/components/share/PickupCode";
import ShareDownload from "@/components/share/ShareDownload";
import ShareReport from "@/components/share/ShareReport";
import { href, resolveLang } from "@/i18n/routing";
import { share } from "@/i18n/messages/share";
import { getClientIp } from "@/lib/client-ip";
import {
  deepLink,
  formatBytes,
  formatExpiry,
  landingState,
  landingStatus,
  remainingParts,
  SHARE_ROBOTS,
} from "@/lib/share-landing";
import { lookupShare } from "@/lib/share-proxy";

export const prerender = false;

// `[...lang]` 在 SSR 下不会被 getStaticPaths 约束：只认无前缀（en）与 zh。
const langParam = Astro.params.lang;
if (langParam !== undefined && langParam !== "zh") {
  return new Response("Not Found", { status: 404, headers: { "X-Robots-Tag": SHARE_ROBOTS } });
}
const lang = resolveLang(langParam);
const t = share[lang].landing;

const slug = Astro.params.slug ?? "";
const lookup = await lookupShare(slug, getClientIp(Astro.request, Astro.clientAddress));
const state = landingState(lookup);

Astro.response.status = landingStatus(lookup);
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", SHARE_ROBOTS);
if (!lookup.ok && lookup.retryAfter) Astro.response.headers.set("Retry-After", lookup.retryAfter);

const manifest = lookup.ok ? lookup.manifest : null;
const listed = manifest !== null && (state === "ready" || state === "notReady");
const remaining = manifest ? remainingParts(manifest.expiresAt) : null;
const expiry = manifest ? formatExpiry(manifest.expiresAt, lang) : null;

const view = {
  ready: null,
  notReady: { title: t.notReadyTitle, desc: t.notReadyDesc },
  ended: { title: t.endedTitle, desc: t.endedDesc },
  rateLimited: { title: t.rateLimitedTitle, desc: t.rateLimitedDesc },
  unavailable: { title: t.unavailableTitle, desc: t.unavailableDesc },
}[state];

const pageTitle =
  state === "ready" || state === "notReady"
    ? t.meta.title(manifest?.title ?? "")
    : state === "ended"
      ? t.meta.endedTitle
      : t.meta.unavailableTitle;

const showApp = state !== "ended";
---

<Layout lang={lang} title={pageTitle} description={t.meta.description} noindex nofollow>
  <section class="frame" data-share-root data-lang={lang}>
    {
      listed && manifest ? (
        <div class="section">
          <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-16">
            <div class="flex min-w-0 flex-col gap-8">
              <span class="chip self-start">
                {state === "ready" ? <span class="live-dot" /> : <span class="size-1.5 rounded-full bg-warn" />}
                {state === "ready" ? t.statusReady : t.statusLive}
              </span>

              <h1 class="h2 max-w-[24ch] [overflow-wrap:anywhere] [text-wrap:balance]">{manifest.title}</h1>

              <dl class="cells border border-line sm:grid-cols-[1fr_1fr_1.6fr]">
                <div class="px-5 py-4">
                  <dt class="eyebrow-plain">{t.filesHeading}</dt>
                  <dd class="mono num mt-2 text-fg">{t.fileCount(manifest.files.length)}</dd>
                </div>
                <div class="px-5 py-4">
                  <dt class="eyebrow-plain">{t.totalLabel}</dt>
                  <dd class="mono num mt-2 text-fg">{formatBytes(manifest.totalBytes)}</dd>
                </div>
                <div class="px-5 py-4">
                  <dt class="eyebrow-plain">{t.expiresLabel}</dt>
                  <dd class="mono num mt-2 text-fg">
                    <time datetime={manifest.expiresAt} data-share-expiry>{expiry}</time>
                  </dd>
                  {
                    remaining && (
                      <dd class="num mt-1 text-sm text-muted">
                        {t.remaining(remaining.days, remaining.hours, remaining.minutes)}
                      </dd>
                    )
                  }
                </div>
              </dl>

              <p class="lede max-w-[62ch]">{state === "ready" ? t.cloudNote : t.notReadyDesc}</p>

              <div class="flex flex-col items-start gap-3">
                <a class="btn btn-primary btn-lg" href={deepLink(slug)} rel="nofollow">
                  <Download aria-hidden className="size-4" />
                  <span>{t.openApp}</span>
                </a>
                <p class="text-sm text-muted">
                  {t.openAppHint}
                  <a class="link ml-1 inline-flex items-center gap-0.5" href={href("/download", lang)}>
                    {t.getApp}
                    <ArrowUpRight aria-hidden className="size-3.5" />
                  </a>
                </p>
              </div>
            </div>

            {
              manifest.pickupCode && (
                <aside class="lg:sticky lg:top-[calc(var(--header-h)+32px)]">
                  <PickupCode client:load code={manifest.pickupCode} labels={t.pickupCode} />
                </aside>
              )
            }
          </div>
        </div>
      ) : (
        view && (
          <div class="section flex flex-col items-start gap-6">
            <h1 class="h2 max-w-[24ch] [text-wrap:balance]">{view.title}</h1>
            <p class="lede max-w-[62ch]">{view.desc}</p>
            <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
              {
                showApp && (
                  <a class="btn btn-primary btn-lg" href={deepLink(slug)} rel="nofollow">
                    <Download aria-hidden className="size-4" />
                    <span>{t.openApp}</span>
                  </a>
                )
              }
              <a class="link inline-flex items-center gap-0.5 text-sm" href={href("/download", lang)}>
                {t.getApp}
                <ArrowUpRight aria-hidden className="size-3.5" />
              </a>
            </div>
          </div>
        )
      )
    }

    {
      listed && manifest && (
        <>
          <div class="rule" />
          <div class="section-tight">
            <h2 class="h3 mb-6">{t.filesHeading}</h2>
            {state === "ready" ? (
              <ShareDownload
                client:load
                slug={slug}
                files={manifest.files}
                siteKey={manifest.turnstileSiteKey}
                lang={lang}
                labels={{
                  download: t.download,
                  preparing: t.preparing,
                  started: t.started,
                  verify: t.verify,
                  errors: t.errors,
                }}
              />
            ) : (
              <ul class="cells border border-line">
                {manifest.files.map((file) => (
                  <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-5 py-4">
                    <span class="min-w-0 font-medium text-fg [overflow-wrap:anywhere]">{file.name}</span>
                    <span class="mono num text-sm text-muted">{formatBytes(file.size)}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </>
      )
    }

    {
      manifest && (
        <>
          <div class="rule" />
          <div class="section-tight">
            <ShareReport
              client:visible
              slug={slug}
              siteKey={manifest.turnstileSiteKey}
              lang={lang}
              labels={{ ...t.report, errors: t.errors }}
            />
          </div>
        </>
      )
    }
  </section>
</Layout>

<script>
  // 过期时刻：服务端按 UTC 直出，浏览器里换成访客本地时区。
  import { formatExpiryLocal } from "@/lib/share-landing";

  const root = document.querySelector<HTMLElement>("[data-share-root]");
  const lang = root?.dataset.lang === "zh" ? "zh" : "en";
  for (const el of document.querySelectorAll<HTMLTimeElement>("time[data-share-expiry]")) {
    const local = formatExpiryLocal(el.dateTime, lang);
    if (local) el.textContent = local;
  }
</script>
