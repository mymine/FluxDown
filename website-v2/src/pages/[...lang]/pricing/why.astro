---
import { ArrowLeft, ArrowRight, ShieldCheck } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import CompareTable from "@/components/pricing/CompareTable.astro";
import { langStaticPaths, resolveLang, href } from "@/i18n/routing";
import { pricingWhy } from "@/i18n/messages/pricingWhy";

export const getStaticPaths = langStaticPaths;
const lang = resolveLang(Astro.params.lang);
const t = pricingWhy[lang];
---

<Layout lang={lang} title={t.meta.title} description={t.meta.description}>
  <PageHeader eyebrow={t.eyebrow} title={t.title} lede={t.intro}>
    <a class="btn btn-ghost" href={href("/pricing", lang)}>
      <ArrowLeft size={15} aria-hidden="true" />
      {t.back}
    </a>
    <a class="btn btn-secondary" href={href("/pricing/vote", lang)}>
      {t.vote}
      <ArrowRight size={15} aria-hidden="true" />
    </a>
  </PageHeader>

  <div class="frame">
    <div class="section grid grid-cols-1 gap-12 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-16">
      <nav aria-labelledby="why-toc" class="lg:sticky lg:top-[calc(var(--header-h)+32px)] lg:self-start">
        <p id="why-toc" class="eyebrow-plain mb-4">{t.contents}</p>
        <ol class="flex flex-col border-l border-line">
          {
            t.sections.map((s, i) => (
              <li>
                <a
                  href={`#${s.id}`}
                  class="-ml-px flex items-baseline gap-3 border-l border-transparent py-1.5 pl-4 text-sm text-muted transition-colors hover:border-accent hover:text-fg"
                >
                  <span class="num font-mono text-[11px] text-subtle">{String(i + 1).padStart(2, "0")}</span>
                  {s.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <article class="max-w-[72ch]">
        <aside class="mb-14 flex gap-4 border border-line bg-sunken px-5 py-4" data-reveal>
          <span class="chip h-[22px] shrink-0 font-mono text-[10.5px] uppercase tracking-[0.12em] text-accent-ink">
            {t.draftLabel}
          </span>
          <p class="text-sm leading-relaxed text-muted">{t.draftNote}</p>
        </aside>

        {
          t.sections.map((s, i) => (
            <section id={s.id} aria-labelledby={`${s.id}-h`} class="scroll-mt-[calc(var(--header-h)+24px)] [&+&]:mt-16">
              <p class="num mb-3 font-mono text-xs text-subtle">§ {String(i + 1).padStart(2, "0")}</p>
              <h2 id={`${s.id}-h`} class="h3" data-reveal>
                {s.title}
              </h2>
              {s.body.map((p) => (
                <p class="mt-4 text-[15.5px] leading-[1.75] text-muted">{p}</p>
              ))}

              {s.id === "free-users" && (
                <>
                  <div class="mt-8" data-reveal>
                    <CompareTable lang={lang} figTag="fig. 01" />
                  </div>
                  <p class="mt-8 text-[15.5px] leading-[1.75] text-muted">{t.afterTable}</p>
                  <div class="mt-8 border-l-2 border-ok bg-[color-mix(in_oklch,var(--ok)_7%,transparent)] px-5 py-4">
                    <p class="flex items-center gap-2 text-sm font-semibold text-ok">
                      <ShieldCheck size={16} aria-hidden="true" />
                      {t.selfHostTitle}
                    </p>
                    <p class="mt-2 text-[15px] leading-[1.7] text-muted">{t.selfHostBody}</p>
                  </div>
                </>
              )}

              {s.id === "decide" && (
                <div class="mt-8 flex flex-wrap gap-3">
                  <a class="btn btn-primary" href={href("/pricing/vote", lang)}>
                    {t.cta}
                    <ArrowRight size={15} aria-hidden="true" />
                  </a>
                  <a class="btn btn-ticks" href={href("/pricing", lang)}>
                    {t.ctaSecondary}
                  </a>
                </div>
              )}
            </section>
          ))
        }
      </article>
    </div>
    <div class="rule"></div>
  </div>
</Layout>
