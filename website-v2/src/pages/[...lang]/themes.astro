---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import ThemeMarket from "@/components/markets/ThemeMarket";
import HowTo from "@/components/markets/HowTo.astro";
import { markets } from "@/i18n/messages/markets";
import { langStaticPaths, resolveLang, href } from "@/i18n/routing";
import { THEMES_REPO, contributeGuidePath, githubUrl } from "@/lib/ecosystem";
import { ArrowRight, Palette } from "lucide-react";
export const getStaticPaths = langStaticPaths;
const lang = resolveLang(Astro.params.lang);
const t = markets[lang].themes;
const guide = href(contributeGuidePath(lang, "contributing/themes"), lang);
---

<Layout lang={lang} title={t.metaTitle} description={t.metaDescription}>
  <PageHeader eyebrow={t.eyebrow} title={t.title} lede={t.lede}>
    <a class="btn btn-primary" href={href("/theme-builder", lang)}>
      <Palette size={15} aria-hidden="true" />
      {t.builderCta}
    </a>
    <a class="btn btn-secondary" href={guide}>
      {t.submitCta}
      <ArrowRight size={15} aria-hidden="true" />
    </a>
  </PageHeader>

  <section class="frame">
    <ThemeMarket client:load lang={lang} />
  </section>

  <HowTo
    eyebrow={t.howTo.eyebrow}
    title={t.howTo.title}
    steps={[t.howTo.step1, t.howTo.step2, t.howTo.step3]}
    links={[
      { href: guide, label: t.howTo.guideLink },
      { href: githubUrl(THEMES_REPO), label: THEMES_REPO, external: true, brand: "github" },
    ]}
  />
</Layout>
