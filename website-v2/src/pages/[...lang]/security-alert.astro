---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import { BrandIcon } from "@/components/icons/brand";
import { langStaticPaths, resolveLang, href } from "@/i18n/routing";
import { guides } from "@/i18n/messages/guides";
import { GITHUB_URL } from "@/lib/site-nav";
import { OFFICIAL_SITES } from "@/lib/announcements";

export const getStaticPaths = langStaticPaths;
const lang = resolveLang(Astro.params.lang);
const t = guides[lang].security;

const n = (i: number) => String(i + 1).padStart(2, "0");
---

<Layout lang={lang} title={t.meta.title} description={t.meta.description}>
  <PageHeader eyebrow={t.eyebrow} title={t.title} lede={t.lede} />

  <section class="frame">
    <div class="cells grid grid-cols-1 md:grid-cols-2">
      <div class="cell domain domain-bad">
        <p class="domain-label mono">
          <span class="dot" aria-hidden="true"></span>
          {t.fakeLabel}
        </p>
        <p class="mt-5 font-mono text-[clamp(1.1rem,2.2vw,1.45rem)] text-fg">
          <s class="decoration-danger/70 decoration-2">{t.fakeSite}</s>
        </p>
      </div>
      <div class="cell domain domain-ok">
        <p class="domain-label mono">
          <span class="dot" aria-hidden="true"></span>
          {t.officialLabel}
        </p>
        <ul class="mt-4 grid gap-1">
          {
            OFFICIAL_SITES.map((site, i) => (
              <li>
                <a class="site" href={site}>
                  <span class="font-mono">{site.replace("https://", "")}</span>
                  {i === 0 && <span class="chip h-5 px-2 text-[11px]">{t.primary}</span>}
                  <span class="site-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="rule"></div>

    <div class="section-tight grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
      <section aria-labelledby="advice-h">
        <h2 id="advice-h" class="h3">{t.adviceTitle}</h2>
        <ol class="list mt-6">
          {
            t.advice.map((a, i) => (
              <li data-reveal style={`--d:${i}`}>
                <span class="list-n mono num" aria-hidden="true">
                  {n(i)}
                </span>
                <span>{a}</span>
              </li>
            ))
          }
        </ol>
      </section>
      <section aria-labelledby="verify-h">
        <h2 id="verify-h" class="h3">{t.verifyTitle}</h2>
        <ol class="list mt-6">
          {
            t.verify.map((a, i) => (
              <li data-reveal style={`--d:${i}`}>
                <span class="list-n mono num" aria-hidden="true">
                  {n(i)}
                </span>
                <span>{a}</span>
              </li>
            ))
          }
        </ol>
        <a class="link mt-5 inline-block text-[14px]" href={href("/code-signing", lang)}>{t.signingLink} →</a>
      </section>
    </div>

    <div class="rule"></div>

    <div class="section-tight">
      <h2 class="h3">{t.downloadTitle}</h2>
      <p class="lede mt-4 max-w-[64ch]">{t.downloadNote}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={href("/download", lang)}>
          {t.downloadCta}
          <span aria-hidden="true">→</span>
        </a>
        <a class="btn btn-secondary" href={`${GITHUB_URL}/releases`} target="_blank" rel="noopener noreferrer">
          <BrandIcon name="github" size={15} />
          GitHub Releases
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .domain {
    --tone: var(--ok);
  }
  .domain-bad {
    --tone: var(--danger);
    background: color-mix(in oklch, var(--danger) 4%, var(--bg));
  }
  .domain-ok {
    background: color-mix(in oklch, var(--ok) 4%, var(--bg));
  }
  .domain-label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tone);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 99px;
    background: var(--tone);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--tone) 22%, transparent);
  }
  .site {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-block: 4px;
    font-size: clamp(0.98rem, 1.6vw, 1.1rem);
    color: var(--fg);
    transition: color 160ms;
  }
  .site:hover {
    color: var(--ok);
  }
  .site:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .site-arrow {
    color: var(--fg-subtle);
    transition: transform 200ms var(--ease-out);
  }
  .site:hover .site-arrow {
    transform: translate(2px, -2px);
    color: var(--ok);
  }

  .list {
    display: grid;
    gap: 18px;
  }
  .list li {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 14px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--fg-muted);
  }
  .list-n {
    padding-top: 3px;
    font-size: 11.5px;
    color: var(--accent-ink);
  }
</style>
