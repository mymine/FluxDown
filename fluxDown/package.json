{
  "name": "flux-down-extension",
  "description": "FluxDown browser extension - intercept downloads and send to FluxDown app",
  "version": "0.1.28",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "postinstall": "wxt prepare",
    "test": "bun test",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "wxt": "^0.20.14"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.1"
  }
}
